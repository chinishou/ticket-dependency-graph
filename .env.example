# =============================================================================
# IMPORTANT: production vs. test must point at DIFFERENT ShotGrid sites.
# Running tests against a production SG site will overwrite real ticket data.
# See README → "Production deployment" and "Testing safety".
# =============================================================================
#
# The app server and the sgEvent daemon now deploy independently
# (docker-compose.yml vs docker-compose.daemon.yml), but both read the same
# .env. The sections below are tagged with which deployment uses which vars.

# -----------------------------------------------------------------------------
# [app] ShotGrid site — used by the bootstrap script and outbound update-ticket
# calls. The app shells out to sg_client.py with these credentials.
# -----------------------------------------------------------------------------
SG_URL=https://your-site.shotgrid.autodesk.com
SCRIPT_NAME=your_script_name
API_KEY=your_api_key

# -----------------------------------------------------------------------------
# [app] Local admin password. Default ('admin2026') is in source; anyone can
# become admin in a fresh deployment until you change this.
# -----------------------------------------------------------------------------
ADMIN_PASSWORD=change-me-in-production

# -----------------------------------------------------------------------------
# [both] Shared secret between app server and sgEvent daemon plugins. Must be
# IDENTICAL in the app's .env and the daemon's .env. Default
# ('sg-internal-dev-secret') is in source — anyone who knows it can hit the
# app's /api/sg/sync/* endpoints and rewrite local entities.
# -----------------------------------------------------------------------------
SG_INTERNAL_SECRET=change-me-to-a-random-string

# -----------------------------------------------------------------------------
# [daemon] Where the daemon plugins POST events.
#
# APP_API_URL is the default for all three plugins. If you want to route
# different entity types to different consuming apps, override per-plugin
# below. Any unset per-plugin variable falls back to APP_API_URL.
# -----------------------------------------------------------------------------
APP_API_URL=http://localhost:3001
# APP_API_URL_TICKET=http://ticket-app.internal:3001
# APP_API_URL_HUMANUSER=http://hr-app.internal:8080
# APP_API_URL_PROJECT=http://ticket-app.internal:3001

# -----------------------------------------------------------------------------
# [daemon] ShotGrid site that the daemon process itself connects to. This is
# the site whose events are forwarded. Usually the same SG site as SG_URL
# above, but kept separate so the daemon can run with reduced credentials.
# -----------------------------------------------------------------------------
SG_ED_SITE_URL=https://your-site.shotgrid.autodesk.com
SG_ED_SCRIPT_NAME=your_daemon_engine_script
SG_ED_API_KEY=your_daemon_engine_key
SG_ED_EMAIL_ENABLED=false

# -----------------------------------------------------------------------------
# [daemon] Per-plugin SG script credentials (from SG admin → Scripts).
#
# Each plugin reads its own *_NAME / *_KEY pair so you CAN have one script per
# plugin for separate audit trails. Operationally, using the SAME script name
# and key for all three is fine — just paste the same values into each pair.
# The script needs read access to Ticket, HumanUser, and Project entities.
# -----------------------------------------------------------------------------
SGDAEMON_TICKET_NAME=
SGDAEMON_TICKET_KEY=
SGDAEMON_HUMANUSER_NAME=
SGDAEMON_HUMANUSER_KEY=
SGDAEMON_PROJECT_NAME=
SGDAEMON_PROJECT_KEY=

# -----------------------------------------------------------------------------
# [app] Frontend fallback for outbound SG sync (optional; defaults to dev
# secret). Must equal SG_INTERNAL_SECRET above. The Vite build embeds this
# value into the JS bundle, so anyone with the bundle can read it — only
# useful as a "wrong secret stops accidental hits", not real authentication.
# -----------------------------------------------------------------------------
VITE_SG_INTERNAL_SECRET=

# -----------------------------------------------------------------------------
# [app] SQLite path. Override per-environment so test/staging/prod never share
# a file.
# -----------------------------------------------------------------------------
DB_PATH=./data.db

# -----------------------------------------------------------------------------
# [app] Set to "1" in test/staging/CI/dev pointing at prod SG. When set,
# /api/sg/update-task-status and /api/sg/update-task-priority return success
# without invoking sg_client.py (no SG mutation). Leave UNSET in production
# where you DO want tech-tree → SG writes.
# -----------------------------------------------------------------------------
SG_WRITE_DISABLED=

# -----------------------------------------------------------------------------
# [app] Which python interpreter to shell out to for SG writes. Defaults to
# "python" on PATH.
# -----------------------------------------------------------------------------
PYTHON_CMD=python3
